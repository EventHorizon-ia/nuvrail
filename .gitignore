# web/fly.web.toml

# gitleaks config MUST be committed — do not ignore it
!.gitleaks.toml
*.p12
*.pfx

# Nuvrail runtime data dirs
# (created if NUVRAIL_DATA_DIR is set to a relative path or ~ is not expanded)
.nuvrail/
~/
~
/data/

